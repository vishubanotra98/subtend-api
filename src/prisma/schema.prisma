// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("refresh_tokens")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  firstName            String?               @map("first_name")
  lastName             String?               @map("last_name")
  email                String?               @unique
  password             String?
  emailVerified        Boolean?              @map("email_verified")
  tokenExpiry          DateTime?
  verificationToken    String?
  refreshTokens        RefreshToken[]
  image                String?
  workspaces           WorkspaceMembers[]
  teams                TeamMembers[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assignedIssues       Issue[]               @relation("Assignee")
  federatedCredentials FederatedCredential[]

  @@map("users")
}

model FederatedCredential {
  id       String @id @default(cuid())
  userId   String
  provider String
  subject  String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([provider, subject])
  @@map("federated_credentials")
}

model GithubIntegration {
  id                   String        @id @default(cuid())
  workspaceId          String        @unique
  access_token         String
  refresh_token        String
  accessTokenExpireAt  DateTime
  refreshTokenExpireAt DateTime
  projectRepos         ProjectRepo[]
  workspace            Workspace     @relation(fields: [workspaceId], references: [id])
}

model ProjectRepo {
  id                  String            @id @default(cuid())
  projectId           String
  githubIntegrationId String
  repoFullName        String
  repoId              Int               @unique
  webhookId           String?
  project             Project           @relation(fields: [projectId], references: [id])
  githubIntegration   GithubIntegration @relation(fields: [githubIntegrationId], references: [id])

  @@unique([projectId, repoId])
  @@map("project_repos")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  members           WorkspaceMembers[]
  teams             Team[]
  statuses          Status[]
  createdAt         DateTime           @default(now())
  invitations       Invitation[]
  collabs           Collab[]
  deletedAt         DateTime?
  githubIntegration GithubIntegration?
  nextTicketNumber  Int                @default(1)
}

model WorkspaceMembers {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

model Team {
  id          String        @id @default(cuid())
  name        String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  members     TeamMembers[]
  projects    Project[]
  deletedAt   DateTime?

  createdAt DateTime @default(now())
}

model TeamMembers {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  @@unique([userId, teamId])
}

model Project {
  id              String           @id @default(cuid())
  name            String
  projectOverview String?          @db.Text
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  issues          Issue[]
  projectCollabs  ProjectCollabs[]

  createdAt    DateTime      @default(now())
  targetDate   DateTime?     @map("target_date")
  completedAt  DateTime?     @map("completed_at")
  deletedAt    DateTime?
  projectRepos ProjectRepo[]
  gitHistories GitHistory[]
}

model Issue {
  id            String    @id @default(cuid())
  title         String
  ticket_num    String
  description   String?   @db.Text
  priority      Priority? @default(LOW)
  blockedReason String?   @db.Text
  blockedAt     DateTime? @map("blocked_at")
  status        Status?   @relation(fields: [statusId], references: [id])
  statusId      String?
  assignee      User?     @relation(name: "Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId    String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String?
  targetDate    DateTime? @map("target_date")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deletedAt    DateTime?
  gitHistories GitHistory[]
}

model GitHistory {
  id String @id @default(cuid())

  projectId    String
  issueId      String
  ticketNumber Int

  repoId Int

  type GitHistoryType

  pullReqId Int?
  title     String?
  closedAt  DateTime?

  head String?
  base String?

  pushHead String?
  pushedAt DateTime?

  commits Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([projectId])
  @@index([repoId])
  @@map("git_history")
}

model Collab {
  id             String           @id @default(cuid())
  name           String
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectCollabs ProjectCollabs[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectCollabs {
  id        String   @id @default(cuid())
  collabId  String
  projectId String
  collab    Collab   @relation(fields: [collabId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([collabId, projectId])
  @@map("project_collabs")
}

model Status {
  id    String @id @default(cuid())
  name  String
  color String
  order Int    @default(0)

  isBlocked    Boolean @default(false)
  isCompleted  Boolean @default(false)
  isDefault    Boolean @default(false)
  isInitial    Boolean @default(false)
  isInProgress Boolean @default(false)
  isCancelled  Boolean @default(false)
  isInReview   Boolean @default(false)
  issues       Issue[]

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  workspaceId String
  status      String   @default("PENDING")
  expires     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
}

model Activity {
  id          String @id @default(cuid())
  action      String
  workspaceId String
  actor       Json?
  team        Json?
  project     Json?
  issue       Json?
  beforeState Json?  @map("before_state")
  afterState  Json?  @map("after_state")

  created_at DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GitHistoryType {
  PUSH
  PULL_REQUEST
}
